meta {
  name: Login colaborador
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{colaboradorUser}}",
    "password": "{{colaboradorPass}}"
  }
}

script:post-response {
  const cookies = [].concat(res.getHeader("set-cookie") || []);
  const session = cookies.find((c) => c.startsWith("portal_token="));
  if (session) {
    bru.setVar("token", session.split(";")[0].substring("portal_token=".length));
  }
}

tests {
  test("autentica com sucesso", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("retorna o usuário sem a senha", function () {
    const { user } = res.getBody();
    expect(user.username).to.equal(bru.getEnvVar("colaboradorUser"));
    expect(user).to.not.have.property("passwordHash");
  });

  test("define o cookie de sessão httpOnly", function () {
    const cookie = [].concat(res.getHeader("set-cookie") || []).join(";");
    expect(cookie).to.contain("portal_token=");
    expect(cookie).to.contain("HttpOnly");
  });
}

docs {
  Autentica como **colaborador** e guarda o token da sessão na variável `token`.
}
